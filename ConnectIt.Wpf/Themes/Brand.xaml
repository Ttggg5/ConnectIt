<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!--
        ConnectIt「Aurora」品牌設計系統:跟主題(淺色/深色)無關的品牌色、漸層與共用樣式。
        會隨主題變化的表面/文字色在 Brand.Dark.xaml / Brand.Light.xaml,這裡一律用 DynamicResource 參照,
        ThemeService 切換主題時替換那份字典,這裡的樣式就會自動跟著更新。
        Android 端(ui/theme/Color.kt)與影片網站 CSS 使用同一組色票,改色時要三邊一起改。
    -->

    <!-- ===================== 品牌色/漸層 ===================== -->
    <Color x:Key="Brand.Color.Primary">#6366F1</Color>
    <Color x:Key="Brand.Color.Accent">#22D3EE</Color>
    <Color x:Key="Brand.Color.Success">#22C55E</Color>
    <Color x:Key="Brand.Color.Warning">#F59E0B</Color>
    <Color x:Key="Brand.Color.Error">#EF4444</Color>

    <SolidColorBrush x:Key="Brand.Brush.Accent" Color="#22D3EE"/>
    <SolidColorBrush x:Key="Brand.Brush.Success" Color="#22C55E"/>
    <SolidColorBrush x:Key="Brand.Brush.Warning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Brand.Brush.Error" Color="#EF4444"/>
    <SolidColorBrush x:Key="Brand.Brush.OnGradient" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brand.Brush.OnGradientMuted" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="Brand.Brush.GlassOnGradient" Color="#26FFFFFF"/>

    <LinearGradientBrush x:Key="Brand.Brush.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brand.Brush.GradientHorizontal" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>

    <CornerRadius x:Key="Brand.Radius.Card">20</CornerRadius>
    <CornerRadius x:Key="Brand.Radius.Control">12</CornerRadius>
    <CornerRadius x:Key="Brand.Radius.Pill">14</CornerRadius>

    <FontFamily x:Key="Brand.Font">Segoe UI Variable Text, Microsoft JhengHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Brand.Font.Display">Segoe UI Variable Display, Microsoft JhengHei UI, Segoe UI</FontFamily>

    <!-- ===================== 文字 ===================== -->
    <Style x:Key="Brand.Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Brand.Font.Display}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Brand.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Brand.Font.Display}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.Text}"/>
    </Style>

    <Style x:Key="Brand.Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.Text}"/>
    </Style>

    <Style x:Key="Brand.Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.Text}"/>
    </Style>

    <Style x:Key="Brand.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.TextMuted}"/>
    </Style>

    <Style x:Key="Brand.Text.Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.TextMuted}"/>
    </Style>

    <!-- ===================== 卡片 ===================== -->
    <Style x:Key="Brand.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brand.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Brush.Outline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Brand.Radius.Card}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- 可互動的清單卡片(裝置/影片伺服器):滑鼠移上去時微微亮起,邊框換成主色。 -->
    <Style x:Key="Brand.Card.Interactive" TargetType="Border" BasedOn="{StaticResource Brand.Card}">
        <Setter Property="Padding" Value="16,14"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brand.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brand.Brush.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Brand.Hero" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brand.Brush.HeroBackground}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brand.Brush.OnGradient}"/>
    </Style>

    <!-- 圓形漸層頭像(裝置/影片伺服器/對話框)。內容放一個 PackIcon。 -->
    <Style x:Key="Brand.Avatar" TargetType="Border">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Background" Value="{StaticResource Brand.Brush.Gradient}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brand.Brush.OnGradient}"/>
    </Style>

    <!-- 圓角膠囊狀態標籤,例如「廣播中」「已連線」。 -->
    <Style x:Key="Brand.Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Brand.Radius.Pill}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Background" Value="{DynamicResource Brand.Brush.PrimarySoft}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brand.Brush.Primary}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Brand.Pill.OnGradient" TargetType="Border" BasedOn="{StaticResource Brand.Pill}">
        <Setter Property="Background" Value="{StaticResource Brand.Brush.GlassOnGradient}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brand.Brush.OnGradient}"/>
    </Style>

    <Style x:Key="Brand.Pill.Success" TargetType="Border" BasedOn="{StaticResource Brand.Pill}">
        <Setter Property="Background" Value="#2622C55E"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brand.Brush.Success}"/>
    </Style>

    <!-- 「呼吸」的小圓點,搭配狀態標籤表示「正在進行中」。 -->
    <Style x:Key="Brand.BreathingDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="{StaticResource Brand.Brush.Success}"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== 按鈕 ===================== -->
    <Style x:Key="Brand.Button.Gradient" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brand.Brush.OnGradient}"/>
        <Setter Property="Background" Value="{StaticResource Brand.Brush.Gradient}"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Brand.Radius.Control}"/>
                        <Border x:Name="Hover" Background="#FFFFFF" Opacity="0" CornerRadius="{StaticResource Brand.Radius.Control}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.14"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Brand.Button.Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Brush.Outline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Brand.Radius.Control}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brand.Brush.SurfaceVariant}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brand.Brush.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brand.Brush.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危險操作(中斷連線、停止分享):外觀同 Ghost,文字與滑過邊框換成紅色。 -->
    <Style x:Key="Brand.Button.Danger" TargetType="Button" BasedOn="{StaticResource Brand.Button.Ghost}">
        <Setter Property="Foreground" Value="{StaticResource Brand.Brush.Error}"/>
    </Style>

    <!-- 放在漸層 Hero 上的半透明按鈕。 -->
    <Style x:Key="Brand.Button.Glass" TargetType="Button" BasedOn="{StaticResource Brand.Button.Ghost}">
        <Setter Property="Foreground" Value="{StaticResource Brand.Brush.OnGradient}"/>
        <Setter Property="Background" Value="{StaticResource Brand.Brush.GlassOnGradient}"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
    </Style>

    <!-- 圓形圖示按鈕(工具列、清單項目上的小動作)。 -->
    <Style x:Key="Brand.Button.Icon" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brand.Brush.SurfaceVariant}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brand.Brush.SurfaceVariant}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Brand.Button.Icon.OnGradient" TargetType="Button" BasedOn="{StaticResource Brand.Button.Icon}">
        <Setter Property="Foreground" Value="{StaticResource Brand.Brush.OnGradient}"/>
        <Setter Property="Background" Value="{StaticResource Brand.Brush.GlassOnGradient}"/>
    </Style>

    <!-- 大型圓形漸層播放鍵(遙控面板)。 -->
    <Style x:Key="Brand.Button.Play" TargetType="Button" BasedOn="{StaticResource Brand.Button.Gradient}">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Fill="{TemplateBinding Background}"/>
                        <Ellipse x:Name="Hover" Fill="#FFFFFF" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.14"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 只有文字的連結式按鈕(例如「取消」「重新顯示引導」)。 -->
    <Style x:Key="Brand.Button.Text" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Brand.Radius.Control}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brand.Brush.PrimarySoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 導覽列 ===================== -->
    <Style x:Key="Brand.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.TextMuted}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="16" Background="Transparent"/>
                        <Border x:Name="Selected" CornerRadius="16" Background="{StaticResource Brand.Brush.Gradient}" Opacity="0"/>
                        <ContentPresenter Margin="0,10" HorizontalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brand.Brush.SurfaceVariant}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brand.Brush.SurfaceVariant}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource Brand.Brush.OnGradient}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 分段切換鈕(影片頁「觀看 / 分享」) ===================== -->
    <Style x:Key="Brand.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.TextMuted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent"/>
                        <Border x:Name="Selected" CornerRadius="10" Background="{StaticResource Brand.Brush.Gradient}" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brand.Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Selected" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource Brand.Brush.OnGradient}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 進度條(傳輸進度):漸層填色、圓角軌道 ===================== -->
    <Style x:Key="Brand.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="4" Background="{DynamicResource Brand.Brush.SurfaceVariant}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left"
                                Background="{StaticResource Brand.Brush.GradientHorizontal}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 雷達掃描動畫(搜尋裝置中) =====================
         三道同心圓由中心往外擴散、淡出,中間是一個漸層圓形,內容(通常是 PackIcon)放在圓心。 -->
    <Style x:Key="Brand.Radar" TargetType="ContentControl">
        <Setter Property="Width" Value="160"/>
        <Setter Property="Height" Value="160"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource Brand.Brush.OnGradient}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0.35" To="1" Duration="0:0:2.4" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0.35" To="1" Duration="0:0:2.4" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="Opacity"
                                                     From="0.9" To="0" Duration="0:0:2.4" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0.35" To="1" Duration="0:0:2.4" BeginTime="0:0:0.8" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0.35" To="1" Duration="0:0:2.4" BeginTime="0:0:0.8" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="Opacity"
                                                     From="0.9" To="0" Duration="0:0:2.4" BeginTime="0:0:0.8" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="Ring3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0.35" To="1" Duration="0:0:2.4" BeginTime="0:0:1.6" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="Ring3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0.35" To="1" Duration="0:0:2.4" BeginTime="0:0:1.6" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="Ring3" Storyboard.TargetProperty="Opacity"
                                                     From="0.9" To="0" Duration="0:0:2.4" BeginTime="0:0:1.6" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        </Grid.Triggers>
                        <Ellipse x:Name="Ring1" Stroke="{StaticResource Brand.Brush.Gradient}" StrokeThickness="2"
                                 Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.3" ScaleY="0.3"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Ring2" Stroke="{StaticResource Brand.Brush.Gradient}" StrokeThickness="2"
                                 Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.3" ScaleY="0.3"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Ring3" Stroke="{StaticResource Brand.Brush.Gradient}" StrokeThickness="2"
                                 Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.3" ScaleY="0.3"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="64" Height="64" Fill="{StaticResource Brand.Brush.Gradient}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 設定卡片標題列左側的圓角圖示底。 -->
    <Style x:Key="Brand.IconTile" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource Brand.Brush.PrimarySoft}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brand.Brush.Primary}"/>
    </Style>

    <!-- 「已儲存 ✓」回饋標籤:由程式碼設成 Visible 後自己淡出(見 MainWindow.Settings.cs FlashSaved)。 -->
    <Style x:Key="Brand.SavedBadge" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brand.Brush.Success}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===================== 捲軸:細、圓角、沒有箭頭(套用到整個 App) ===================== -->
    <Style x:Key="Brand.ScrollBar.PageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Brand.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" CornerRadius="4" Margin="2" Background="{DynamicResource Brand.Brush.Outline}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Brand.Brush.TextMuted}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Brand.Brush.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Brand.ScrollBar.PageButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Brand.ScrollBar.PageButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Brand.ScrollBar.Thumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Brand.ScrollBar.PageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Brand.ScrollBar.PageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Brand.ScrollBar.Thumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
