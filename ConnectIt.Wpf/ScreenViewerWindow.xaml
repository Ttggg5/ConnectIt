<Window x:Class="ConnectIt.Wpf.ScreenViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="螢幕鏡像" Width="1120" Height="700" MinWidth="480" MinHeight="320"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        FontFamily="{StaticResource Brand.Font}"
        TextElement.FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewTextInput="Window_PreviewTextInput"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具列:對象、能不能操控、更新率;Android 的返回/主畫面/最近使用;全螢幕;停止 -->
        <Border x:Name="Toolbar" Background="#FF12141F" Padding="14,6" TextElement.Foreground="White">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="AndroidNavPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,6,0">
                        <Button Style="{StaticResource Brand.Button.Icon.OnGradient}" Width="34" Height="34" ToolTip="返回(滑鼠右鍵也可以)"
                                Click="NavBackButton_Click" Focusable="False">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource Brand.Button.Icon.OnGradient}" Width="34" Height="34" Margin="4,0,0,0" ToolTip="主畫面"
                                Click="NavHomeButton_Click" Focusable="False">
                            <materialDesign:PackIcon Kind="CircleOutline" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource Brand.Button.Icon.OnGradient}" Width="34" Height="34" Margin="4,0,0,0" ToolTip="最近使用的應用程式"
                                Click="NavRecentsButton_Click" Focusable="False">
                            <materialDesign:PackIcon Kind="SquareOutline" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="FullScreenButton" Style="{StaticResource Brand.Button.Icon.OnGradient}" Width="34" Height="34"
                            ToolTip="全螢幕(F11)" Click="FullScreenButton_Click" Focusable="False">
                        <materialDesign:PackIcon x:Name="FullScreenIcon" Kind="Fullscreen" Width="18" Height="18"/>
                    </Button>
                    <Button AutomationProperties.AutomationId="StopViewingButton" Style="{StaticResource Brand.Button.Danger}"
                            Margin="10,0,0,0" Padding="14,6" Click="StopButton_Click" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="StopCircleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="停止觀看" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CastConnected" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" Margin="8,0,12,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <Border CornerRadius="10" Padding="8,2" Background="#33FFFFFF" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="ControlStateIcon" Kind="Eye" Width="13" Height="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ControlStateText" Text="僅觀看" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="FpsText" FontSize="11" Foreground="#99FFFFFF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="ScreenHost" Grid.Row="1" Background="Black" Focusable="True" FocusVisualStyle="{x:Null}">
            <Image x:Name="ScreenImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseDown="ScreenImage_MouseDown" MouseUp="ScreenImage_MouseUp"
                   MouseMove="ScreenImage_MouseMove" MouseWheel="ScreenImage_MouseWheel"/>

            <StackPanel x:Name="WaitingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="36" Height="36"
                             Foreground="White"/>
                <TextBlock x:Name="WaitingText" Text="正在等待對方的畫面…" Foreground="White" FontSize="15" Margin="0,14,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
