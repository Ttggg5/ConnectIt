<Window x:Class="ConnectIt.Wpf.ScreenSharingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ConnectIt — 正在分享螢幕"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource Brand.Font}"
        TextElement.FontSize="13"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- 分享螢幕期間一直浮在畫面最上層的提示條:讓這台電腦前面的人隨時知道正在被觀看/操控,並可以一鍵中斷。
         可以拖曳移動;按鈕以外的地方按住就能拖。 -->
    <Border CornerRadius="22" Background="#F012141F" BorderBrush="{DynamicResource Brand.Brush.Error}" BorderThickness="2"
            Padding="14,6,6,6" Margin="8" TextElement.Foreground="White" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="LiveDot" Width="10" Height="10" Fill="{DynamicResource Brand.Brush.Error}" VerticalAlignment="Center">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <materialDesign:PackIcon x:Name="ModeIcon" Kind="MonitorEye" Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Margin="8,0,14,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Text="正在分享螢幕"/>
                <TextBlock x:Name="DetailText" FontSize="11" Opacity="0.75" Text=""/>
            </StackPanel>
            <Button x:Name="OpenMainButton" Style="{StaticResource Brand.Button.Icon.OnGradient}" Width="32" Height="32"
                    ToolTip="開啟 ConnectIt" Click="OpenMainButton_Click" Focusable="False" Cursor="Hand">
                <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16"/>
            </Button>
            <Button x:Name="StopButton" AutomationProperties.AutomationId="IndicatorStopButton"
                    Style="{StaticResource Brand.Button.Danger}" Margin="6,0,0,0" Padding="14,4" Height="32"
                    Background="{DynamicResource Brand.Brush.Error}" BorderBrush="{DynamicResource Brand.Brush.Error}" Foreground="White"
                    Content="中斷" ToolTip="立刻停止分享螢幕(對方會被斷開)" Click="StopButton_Click" Focusable="False" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>
