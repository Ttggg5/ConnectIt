<Window x:Class="ConnectIt.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConnectIt.Wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="ConnectIt" Height="600" Width="840"
        Icon="Assets/AppIcon.ico"
        MinHeight="480" MinWidth="640"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <materialDesign:DialogHost x:Name="RootDialogHost" Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== 導覽列 ===================== -->
            <materialDesign:ColorZone x:Name="NavColorZone" Grid.Column="0" Mode="PrimaryMid">
                <StackPanel Width="84">
                    <ListBox x:Name="NavListBox" AutomationProperties.AutomationId="NavListBox"
                             Margin="0,16,0,0" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="NavListBox_SelectionChanged">
                        <ListBoxItem AutomationProperties.AutomationId="NavDevicesItem" HorizontalContentAlignment="Center">
                            <StackPanel Margin="0,8" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Devices" Width="24" Height="24" HorizontalAlignment="Center" Foreground="white"/>
                                <TextBlock Text="裝置" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="white"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.AutomationId="NavVideoItem" HorizontalContentAlignment="Center">
                            <StackPanel Margin="0,8" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="VideoBox" Width="24" Height="24" HorizontalAlignment="Center" Foreground="white"/>
                                <TextBlock Text="影片" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="white"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.AutomationId="NavSettingsItem" HorizontalContentAlignment="Center">
                            <StackPanel Margin="0,8" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" HorizontalAlignment="Center" Foreground="white"/>
                                <TextBlock Text="設定" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="white"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </materialDesign:ColorZone>

            <Grid Grid.Column="1">
            <!-- ===================== 裝置探索畫面 ===================== -->
            <Grid x:Name="DiscoveryViewRoot" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Laptop" Width="32" Height="32"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ConnectIt" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="裝置探索與連線" Opacity="0.6" FontSize="12"/>
                        </StackPanel>

                        <TextBox x:Name="DeviceNameTextBox"
                                 materialDesign:HintAssist.Hint="裝置名稱"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Width="200" Margin="24,0,0,0" VerticalAlignment="Center"
                                 KeyDown="DeviceNameTextBox_KeyDown"
                                 LostFocus="DeviceNameTextBox_LostFocus"/>

                        <materialDesign:Chip Content="廣播中" Margin="16,0,0,0" VerticalAlignment="Center"
                                              Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                                              Foreground="white">
                            <materialDesign:Chip.Icon>
                                <materialDesign:PackIcon Kind="Wifi"/>
                            </materialDesign:Chip.Icon>
                        </materialDesign:Chip>
                    </StackPanel>
                </materialDesign:Card>

                <Grid Grid.Row="1" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="SearchProgressBar"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Width="20" Height="20"/>
                        <TextBlock x:Name="SearchStatusText" Text="正在搜尋裝置..."
                                   Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>

                    <Button x:Name="RefreshButton" AutomationProperties.AutomationId="RefreshButton" Grid.Column="1"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="重新搜尋裝置" Visibility="Collapsed"
                            Click="RefreshButton_Click">
                        <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DevicesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="4,4,4,4" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Grid.Column="0" Kind="Devices"
                                                                      Width="28" Height="28"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="15"/>
                                                <TextBlock Opacity="0.6" FontSize="11">
                                                    <Run Text="{Binding Address, Mode=OneWay}"/>
                                                    <Run Text=":"/>
                                                    <Run Text="{Binding Port, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    AutomationProperties.AutomationId="ConnectButton"
                                                    Style="{StaticResource MaterialDesignRaisedLightButton}"
                                                    Tag="{Binding}"
                                                    Click="ConnectToDevice_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="LanConnect" Margin="0,0,6,0" Foreground="white"/>
                                                    <TextBlock Text="連線" Foreground="white"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyStateStackPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="Magnify" Width="48" Height="48" Opacity="0.3"
                                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="尚未找到其他裝置" Opacity="0.5" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Expander Grid.Row="3" Header="狀態紀錄" Margin="0,8,0,0">
                    <TextBox x:Name="LogTextBox" AutomationProperties.AutomationId="LogTextBox"
                             IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                             BorderThickness="0" Background="Transparent"/>
                </Expander>
            </Grid>

            <!-- ===================== 已連線 / 功能畫面 ===================== -->
            <Grid x:Name="ConnectedViewRoot" AutomationProperties.AutomationId="ConnectedViewRoot" Visibility="Collapsed"
                  AllowDrop="True"
                  DragEnter="ConnectedViewRoot_DragEnter" DragOver="ConnectedViewRoot_DragEnter"
                  DragLeave="ConnectedViewRoot_DragLeave" Drop="ConnectedViewRoot_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CheckDecagram" Width="64" Height="64"
                                              HorizontalAlignment="Center"
                                              Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    <TextBlock x:Name="ConnectedDeviceNameText" AutomationProperties.AutomationId="ConnectedDeviceNameText"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="已連線" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="SendFileButton" AutomationProperties.AutomationId="SendFileButton"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="Auto" Padding="20,10" Margin="0,0,12,0" Click="SendFileButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileSend" Margin="0,0,8,0"/>
                                <TextBlock Text="傳送檔案"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SendFolderButton" AutomationProperties.AutomationId="SendFolderButton"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="Auto" Padding="20,10" Margin="0,0,12,0" Click="SendFolderButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderUpload" Margin="0,0,8,0"/>
                                <TextBlock Text="傳送資料夾"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="DisconnectButton"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="Auto" Padding="20,10" Click="DisconnectButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LanDisconnect" Margin="0,0,8,0"/>
                                <TextBlock Text="中斷連線"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="或把檔案/資料夾拖曳到這個視窗來傳送" Opacity="0.5" FontSize="11"
                               Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <materialDesign:Card x:Name="FileTransferCard" Grid.Row="1" Margin="16" Padding="16" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FileTransferNameText" Grid.Column="0"
                                       FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button x:Name="CancelFileTransferButton" AutomationProperties.AutomationId="CancelFileTransferButton"
                                    Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="取消傳輸" Click="CancelFileTransferButton_Click">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                            </Button>
                        </Grid>
                        <ProgressBar x:Name="FileTransferProgressBar" Margin="0,8,0,4" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="FileTransferStatusText" Opacity="0.6" FontSize="11"/>
                    </StackPanel>
                </materialDesign:Card>

                <Border x:Name="DropOverlay" Grid.RowSpan="2" Background="#66000000" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileUpload" Width="48" Height="48" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="放開以傳送" Foreground="White" FontSize="16" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== 影片伺服器畫面 ===================== -->
            <Grid x:Name="VideoViewRoot" AutomationProperties.AutomationId="VideoViewRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="VideoBox" Width="32" Height="32"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="影片伺服器" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="VideoServerStatusText" AutomationProperties.AutomationId="VideoServerStatusText"
                                           Text="尚未開啟" Opacity="0.6" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="StreamVideoButton" AutomationProperties.AutomationId="StreamVideoButton"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="Auto" Padding="20,10" Margin="0,0,12,0" Click="StreamVideoButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlayCircleOutline" Margin="0,0,8,0"/>
                                    <TextBlock Text="分享單一影片"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShareVideoFolderButton" AutomationProperties.AutomationId="ShareVideoFolderButton"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="Auto" Padding="20,10" Margin="0,0,12,0" Click="ShareVideoFolderButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderPlay" Margin="0,0,8,0"/>
                                    <TextBlock Text="分享影片資料夾"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopVideoServerButton" AutomationProperties.AutomationId="StopVideoServerButton"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="Auto" Padding="20,10" Click="StopVideoServerButton_Click"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Stop" Margin="0,0,8,0"/>
                                    <TextBlock Text="關閉影片伺服器"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ===================== 遙控模式(主機端控制面板) ===================== -->
                <materialDesign:Card x:Name="RemoteControlCard" Grid.Row="1" Padding="16" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="RemoteDesktop" Width="24" Height="24" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <TextBlock Text="遙控模式" FontSize="16" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="RemoteControlModeToggle" Margin="16,0,0,0" VerticalAlignment="Center"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          Click="RemoteControlModeToggle_Click"/>
                            <TextBlock Text="開啟後,觀看端只能觀看、無法自行操作,畫面跟著這裡的指令同步。"
                                       Opacity="0.6" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel x:Name="RemoteControlDetailPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RemoteControlNowPlayingText" Text="尚未選擇影片" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Slider x:Name="RemoteControlTimelineSlider" Margin="0,8,0,0"
                                    Minimum="0" Maximum="1" Value="0" IsEnabled="False"
                                    PreviewMouseLeftButtonDown="RemoteControlTimelineSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="RemoteControlTimelineSlider_PreviewMouseLeftButtonUp"/>
                            <TextBlock x:Name="RemoteControlPositionText" Text="0:00" Opacity="0.6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <Button x:Name="RemoteControlPreviousButton" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="上一部" Click="RemoteControlPreviousButton_Click">
                                    <materialDesign:PackIcon Kind="SkipPrevious"/>
                                </Button>
                                <Button x:Name="RemoteControlRewindButton" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="倒退 10 秒" Click="RemoteControlRewindButton_Click">
                                    <materialDesign:PackIcon Kind="Rewind10"/>
                                </Button>
                                <Button x:Name="RemoteControlPlayPauseButton" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="播放/暫停" Click="RemoteControlPlayPauseButton_Click">
                                    <materialDesign:PackIcon x:Name="RemoteControlPlayPauseIcon" Kind="Play"/>
                                </Button>
                                <Button x:Name="RemoteControlForwardButton" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="快轉 10 秒" Click="RemoteControlForwardButton_Click">
                                    <materialDesign:PackIcon Kind="FastForward10"/>
                                </Button>
                                <Button x:Name="RemoteControlNextButton" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="下一部" Click="RemoteControlNextButton_Click">
                                    <materialDesign:PackIcon Kind="SkipNext"/>
                                </Button>

                                <ComboBox x:Name="RemoteControlSpeedComboBox" Width="80" Margin="16,0,0,0" VerticalAlignment="Center"
                                          ToolTip="播放速度" SelectionChanged="RemoteControlSpeedComboBox_SelectionChanged">
                                    <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                    <ComboBoxItem Content="1x" Tag="1" IsSelected="True"/>
                                    <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                    <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                    <ComboBoxItem Content="2x" Tag="2"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <Button x:Name="RemoteControlMuteButton" Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="靜音" Click="RemoteControlMuteButton_Click">
                                    <materialDesign:PackIcon x:Name="RemoteControlMuteIcon" Kind="VolumeHigh"/>
                                </Button>
                                <Slider x:Name="RemoteControlVolumeSlider" Width="160" VerticalAlignment="Center"
                                        Minimum="0" Maximum="1" Value="1" TickFrequency="0.05"
                                        ValueChanged="RemoteControlVolumeSlider_ValueChanged"/>
                            </StackPanel>

                            <TextBlock Text="選一部影片開始遙控:" Opacity="0.6" FontSize="12" Margin="0,12,0,4"/>
                            <ItemsControl x:Name="RemoteControlVideoListItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Margin="0,0,8,8" Padding="12,6" Tag="{Binding}"
                                                Click="RemoteControlVideoButton_Click">
                                            <TextBlock Text="{Binding Name}" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <TextBlock Grid.Row="2" Text="區網內的影片伺服器" FontWeight="Medium" Margin="4,0,4,8"/>

                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="VideoServersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="4,4,4,4" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Grid.Column="0" Kind="VideoBox"
                                                                      Width="28" Height="28"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="15"/>
                                                <TextBlock Opacity="0.6" FontSize="11">
                                                    <Run Text="{Binding Address, Mode=OneWay}"/>
                                                    <Run Text=":"/>
                                                    <Run Text="{Binding Port, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    AutomationProperties.AutomationId="WatchVideoServerButton"
                                                    Style="{StaticResource MaterialDesignRaisedLightButton}"
                                                    Tag="{Binding}"
                                                    Click="WatchVideoServer_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Play" Margin="0,0,6,0" Foreground="white"/>
                                                    <TextBlock Text="觀看" Foreground="white"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="VideoServersEmptyStateStackPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Magnify" Width="48" Height="48" Opacity="0.3"
                                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="尚未找到影片伺服器" Opacity="0.5" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===================== 設定畫面 ===================== -->
            <Grid x:Name="SettingsViewRoot" AutomationProperties.AutomationId="SettingsViewRoot"
                  Margin="16" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="設定" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                    <materialDesign:Card Padding="16">
                        <StackPanel>
                            <TextBlock Text="主題外觀" FontWeight="Medium" FontSize="15"/>
                            <TextBlock Text="選擇應用程式要使用的顏色主題。" Opacity="0.6" FontSize="12"
                                       Margin="0,4,0,16" TextWrapping="Wrap"/>

                            <RadioButton x:Name="ThemeLightRadioButton" GroupName="ThemeMode" Tag="Light"
                                         AutomationProperties.AutomationId="ThemeLightRadioButton"
                                         Checked="ThemeRadioButton_Checked" Margin="0,6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="WeatherSunny" VerticalAlignment="Center"/>
                                    <TextBlock Text="淺色" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ThemeDarkRadioButton" GroupName="ThemeMode" Tag="Dark"
                                         AutomationProperties.AutomationId="ThemeDarkRadioButton"
                                         Checked="ThemeRadioButton_Checked" Margin="0,6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="WeatherNight" VerticalAlignment="Center"/>
                                    <TextBlock Text="深色" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ThemeAutoRadioButton" GroupName="ThemeMode" Tag="Auto"
                                         AutomationProperties.AutomationId="ThemeAutoRadioButton"
                                         Checked="ThemeRadioButton_Checked" Margin="0,6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BrightnessAuto" VerticalAlignment="Center"/>
                                    <TextBlock Text="跟隨系統" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="搜尋設定" FontWeight="Medium" FontSize="15"/>
                            <TextBlock Text="開啟 App 時自動搜尋裝置的秒數(預設 30 秒)。" Opacity="0.6" FontSize="12"
                                       Margin="0,4,0,16" TextWrapping="Wrap"/>

                            <TextBox x:Name="SearchDurationTextBox" AutomationProperties.AutomationId="SearchDurationTextBox"
                                     materialDesign:HintAssist.Hint="搜尋秒數"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Width="120" HorizontalAlignment="Left"
                                     PreviewTextInput="SearchDurationTextBox_PreviewTextInput"
                                     KeyDown="SearchDurationTextBox_KeyDown"
                                     LostFocus="SearchDurationTextBox_LostFocus"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="檔案接收" FontWeight="Medium" FontSize="15"/>
                            <TextBlock Text="收到的檔案會儲存到這個資料夾。" Opacity="0.6" FontSize="12"
                                       Margin="0,4,0,16" TextWrapping="Wrap"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DownloadFolderTextBox" AutomationProperties.AutomationId="DownloadFolderTextBox"
                                         Grid.Column="0" IsReadOnly="True" Focusable="False"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button x:Name="BrowseDownloadFolderButton" AutomationProperties.AutomationId="BrowseDownloadFolderButton"
                                        Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="瀏覽" Click="BrowseDownloadFolderButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="連線設定" FontWeight="Medium" FontSize="15"/>
                            <TextBlock Text="監聽連接埠(留空 = 系統自動指派,變更需要重新啟動 App)與主動連線的逾時秒數。"
                                       Opacity="0.6" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"/>

                            <TextBox x:Name="PreferredPortTextBox" AutomationProperties.AutomationId="PreferredPortTextBox"
                                     materialDesign:HintAssist.Hint="監聽連接埠"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Width="160" HorizontalAlignment="Left" Margin="0,0,0,12"
                                     PreviewTextInput="PreferredPortTextBox_PreviewTextInput"
                                     KeyDown="PreferredPortTextBox_KeyDown"
                                     LostFocus="PreferredPortTextBox_LostFocus"/>

                            <TextBox x:Name="ConnectTimeoutTextBox" AutomationProperties.AutomationId="ConnectTimeoutTextBox"
                                     materialDesign:HintAssist.Hint="連線逾時秒數"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Width="160" HorizontalAlignment="Left"
                                     PreviewTextInput="ConnectTimeoutTextBox_PreviewTextInput"
                                     KeyDown="ConnectTimeoutTextBox_KeyDown"
                                     LostFocus="ConnectTimeoutTextBox_LostFocus"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="通知" FontWeight="Medium" FontSize="15"/>
                            <TextBlock Text="建立連線、收到檔案/資料夾、對方斷線時是否跳出系統匣氣泡通知(連線請求一律會跳出確認對話框,不受此設定影響)。"
                                       Opacity="0.6" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>
                            <CheckBox x:Name="NotificationsEnabledCheckBox" AutomationProperties.AutomationId="NotificationsEnabledCheckBox"
                                      Content="啟用通知" Checked="NotificationsEnabledCheckBox_Changed" Unchecked="NotificationsEnabledCheckBox_Changed"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="開機" FontWeight="Medium" FontSize="15"/>
                            <TextBlock Text="開機時自動啟動並直接隱藏到系統匣。" Opacity="0.6" FontSize="12"
                                       Margin="0,4,0,12" TextWrapping="Wrap"/>
                            <CheckBox x:Name="AutoStartCheckBox" AutomationProperties.AutomationId="AutoStartCheckBox"
                                      Content="開機時自動啟動" Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="信任的裝置" FontWeight="Medium" FontSize="15"/>
                            <TextBlock Text="信任的裝置送出連線請求時會直接自動接受,不再跳出確認對話框。"
                                       Opacity="0.6" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TrustedDevicesEmptyText" Opacity="0.5" FontSize="12"
                                       Text="目前沒有信任的裝置(可在收到連線請求時勾選「信任此裝置」加入)。"/>
                            <ItemsControl x:Name="TrustedDevicesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Tag="{Binding}" Click="UntrustDeviceButton_Click"
                                                    Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===================== 影片網站畫面(嵌入式瀏覽器) ===================== -->
            <Grid x:Name="VideoWebViewRoot" AutomationProperties.AutomationId="VideoWebViewRoot" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <materialDesign:ColorZone x:Name="VideoWebViewHeader" Grid.Row="0" Mode="PrimaryMid">
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <Button AutomationProperties.AutomationId="VideoWebViewBackButton"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="返回" Click="VideoWebViewBackButton_Click">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22" Foreground="White"/>
                        </Button>
                        <TextBlock x:Name="VideoWebViewTitleText" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Medium"/>
                    </StackPanel>
                </materialDesign:ColorZone>

                <wv2:WebView2 x:Name="VideoWebView" Grid.Row="1"
                              CoreWebView2InitializationCompleted="VideoWebView_CoreWebView2InitializationCompleted"/>
            </Grid>

            <materialDesign:Snackbar x:Name="MainSnackbar"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                      Margin="16"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
