<Window x:Class="ConnectIt.Wpf.RemoteControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="遙控器 - ConnectIt" Width="400" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Icon="Assets/AppIcon.ico"
        FontFamily="{StaticResource Brand.Font}" TextElement.FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- 外觀做成一支實體遙控器:機身、電源鍵、指示燈、方向盤 + OK、搖桿鍵、彩色功能鍵。顏色固定(不跟淺色/深色主題變)。 -->
    <Window.Resources>
        <SolidColorBrush x:Key="KeyFace" Color="#262C3B"/>
        <SolidColorBrush x:Key="KeyFacePressed" Color="#1B202B"/>
        <SolidColorBrush x:Key="KeyEdge" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="KeyText" Color="#E4E8F4"/>
        <SolidColorBrush x:Key="KeyTextMuted" Color="#8A93AD"/>

        <!-- 所有按鍵共用:圓角(Tag 指定半徑)、按下時縮小並變深。 -->
        <Style x:Key="RemoteKey" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource KeyFace}"/>
            <Setter Property="Foreground" Value="{StaticResource KeyText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource KeyEdge}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Tag" Value="28"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource KeyFacePressed}"/>
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 方向盤的四個方向、搖桿鍵的上下半:透明底,按下時亮一點。 -->
        <Style x:Key="ArmKey" TargetType="Button" BasedOn="{StaticResource RemoteKey}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#11FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrandKey" TargetType="Button" BasedOn="{StaticResource RemoteKey}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6366F1" Offset="0"/>
                        <GradientStop Color="#4F46E5" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="KeyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource KeyTextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0E1322" Offset="0"/>
            <GradientStop Color="#05070D" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <!-- 螢幕比較矮(例如 1080p + 125% 縮放)時整支遙控器放不下,改成可以捲動。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,22,26,18">
        <!-- 機身 -->
        <Border CornerRadius="64,64,48,48" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="26,28">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2B3142" Offset="0"/>
                    <GradientStop Color="#151923" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.7" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <!-- 頂部:電源(結束遙控) / 指示燈 + 對象 / 靜音 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PowerButton" Style="{StaticResource RemoteKey}" Width="52" Height="52" Tag="26" Background="#B4232F"
                            ToolTip="結束遙控" Click="PowerButton_Click">
                        <materialDesign:PackIcon Kind="Power" Width="24" Height="24"/>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse x:Name="StatusLed" Width="10" Height="10" HorizontalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="StatusLedBrush" Color="#3A4152"/>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="StatusLedGlow" BlurRadius="12" ShadowDepth="0" Color="#22D3EE" Opacity="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="PeerNameText" Foreground="{StaticResource KeyTextMuted}" FontSize="12" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource RemoteKey}" Width="52" Height="52" Tag="26" ToolTip="靜音"
                            Click="KeyButton_Click" CommandParameter="AudioVolumeMute">
                        <materialDesign:PackIcon Kind="VolumeOff" Width="22" Height="22"/>
                    </Button>
                </Grid>

                <!-- 方向盤 -->
                <Grid Width="228" Height="228" Margin="0,28,0,0">
                    <Ellipse StrokeThickness="1" Stroke="{StaticResource KeyEdge}">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#2A3040" Offset="0"/>
                                <GradientStop Color="#1E2330" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="Black"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Button x:Name="DPadUp" Style="{StaticResource ArmKey}" Width="84" Height="66" Tag="22" VerticalAlignment="Top" Margin="0,8,0,0"
                            Click="KeyButton_Click" CommandParameter="ArrowUp">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="ChevronUp" Width="34" Height="34" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DPadUpHint" Foreground="{StaticResource KeyTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,-6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DPadDown" Style="{StaticResource ArmKey}" Width="84" Height="66" Tag="22" VerticalAlignment="Bottom" Margin="0,0,0,8"
                            Click="KeyButton_Click" CommandParameter="ArrowDown">
                        <StackPanel>
                            <TextBlock x:Name="DPadDownHint" Foreground="{StaticResource KeyTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,-6" Visibility="Collapsed"/>
                            <materialDesign:PackIcon Kind="ChevronDown" Width="34" Height="34" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DPadLeft" Style="{StaticResource ArmKey}" Width="66" Height="84" Tag="22" HorizontalAlignment="Left" Margin="8,0,0,0"
                            Click="KeyButton_Click" CommandParameter="ArrowLeft">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="34" Height="34"/>
                    </Button>
                    <Button x:Name="DPadRight" Style="{StaticResource ArmKey}" Width="66" Height="84" Tag="22" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Click="KeyButton_Click" CommandParameter="ArrowRight">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="34" Height="34"/>
                    </Button>
                    <Button x:Name="DPadOk" Style="{StaticResource BrandKey}" Width="92" Height="92" Tag="46"
                            Click="KeyButton_Click" CommandParameter="Enter">
                        <Grid>
                            <TextBlock x:Name="DPadOkText" Text="OK" FontSize="20" FontWeight="Bold"/>
                            <materialDesign:PackIcon x:Name="DPadOkIcon" Kind="Play" Width="38" Height="38" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </Grid>

                <!-- 方向盤下方的三顆圓鍵(電腦:返回/開始/切換;Android:上一首/停止/下一首) -->
                <UniformGrid Columns="3" Margin="0,24,0,0">
                    <StackPanel>
                        <Button x:Name="NavKey1" Style="{StaticResource RemoteKey}" Width="56" Height="56" Click="KeyButton_Click" CommandParameter="Escape">
                            <TextBlock x:Name="NavKey1Text" Text="Esc" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                        <TextBlock x:Name="NavKey1Label" Text="返回" Style="{StaticResource KeyLabel}"/>
                    </StackPanel>
                    <StackPanel>
                        <Button x:Name="NavKey2" Style="{StaticResource RemoteKey}" Width="56" Height="56" Click="KeyButton_Click" CommandParameter="Meta">
                            <TextBlock x:Name="NavKey2Text" Text="Win" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                        <TextBlock x:Name="NavKey2Label" Text="開始" Style="{StaticResource KeyLabel}"/>
                    </StackPanel>
                    <StackPanel>
                        <Button x:Name="NavKey3" Style="{StaticResource RemoteKey}" Width="56" Height="56" Click="KeyButton_Click" CommandParameter="Alt+Tab">
                            <TextBlock x:Name="NavKey3Text" Text="Alt+Tab" FontWeight="SemiBold" FontSize="11"/>
                        </Button>
                        <TextBlock x:Name="NavKey3Label" Text="切換" Style="{StaticResource KeyLabel}"/>
                    </StackPanel>
                </UniformGrid>

                <!-- 搖桿鍵 + 播放 -->
                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="60" CornerRadius="30" Background="{StaticResource KeyFace}" BorderBrush="{StaticResource KeyEdge}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <Button Style="{StaticResource ArmKey}" Height="62" Tag="30,30,0,0" ToolTip="音量+" Click="KeyButton_Click" CommandParameter="AudioVolumeUp">
                                <materialDesign:PackIcon Kind="Plus" Width="26" Height="26"/>
                            </Button>
                            <TextBlock Text="VOL" Foreground="{StaticResource KeyTextMuted}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource ArmKey}" Height="62" Tag="0,0,30,30" ToolTip="音量−" Click="KeyButton_Click" CommandParameter="AudioVolumeDown">
                                <materialDesign:PackIcon Kind="Minus" Width="26" Height="26"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource BrandKey}" Width="76" Height="76" Tag="38" ToolTip="播放/暫停"
                                Click="KeyButton_Click" CommandParameter="MediaPlayPause">
                            <materialDesign:PackIcon Kind="PlayPause" Width="34" Height="34"/>
                        </Button>
                        <StackPanel x:Name="SmallTransportKeys" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Style="{StaticResource RemoteKey}" Width="40" Height="40" Tag="20" ToolTip="上一首" Click="KeyButton_Click" CommandParameter="MediaTrackPrevious">
                                <materialDesign:PackIcon Kind="SkipPrevious" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource RemoteKey}" Width="40" Height="40" Tag="20" Margin="10,0" ToolTip="停止" Click="KeyButton_Click" CommandParameter="MediaStop">
                                <materialDesign:PackIcon Kind="Stop" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource RemoteKey}" Width="40" Height="40" Tag="20" ToolTip="下一首" Click="KeyButton_Click" CommandParameter="MediaTrackNext">
                                <materialDesign:PackIcon Kind="SkipNext" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Width="60" CornerRadius="30" Background="{StaticResource KeyFace}" BorderBrush="{StaticResource KeyEdge}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <Button x:Name="RightRockerUp" Style="{StaticResource ArmKey}" Height="62" Tag="30,30,0,0" Click="KeyButton_Click" CommandParameter="PageUp">
                                <materialDesign:PackIcon Kind="ChevronUp" Width="26" Height="26"/>
                            </Button>
                            <TextBlock x:Name="RightRockerLabel" Text="PG" Foreground="{StaticResource KeyTextMuted}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Button x:Name="RightRockerDown" Style="{StaticResource ArmKey}" Height="62" Tag="0,0,30,30" Click="KeyButton_Click" CommandParameter="PageDown">
                                <materialDesign:PackIcon Kind="ChevronDown" Width="26" Height="26"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 功能鍵(只有電腦能用):電視遙控器那種紅/綠/黃/藍鍵 + 一排小鍵 -->
                <StackPanel x:Name="FunctionKeysPanel" Margin="0,28,0,0">
                    <UniformGrid Columns="4">
                        <Button Style="{StaticResource RemoteKey}" Height="56" Tag="12" Margin="0,0,4,0" Click="KeyButton_Click" CommandParameter="F5">
                            <StackPanel>
                                <Border Width="26" Height="5" CornerRadius="3" Background="#E5484D" HorizontalAlignment="Center"/>
                                <TextBlock Text="投影片" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="F5" FontSize="9" Foreground="{StaticResource KeyTextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RemoteKey}" Height="56" Tag="12" Margin="4,0" Click="KeyButton_Click" CommandParameter="b">
                            <StackPanel>
                                <Border Width="26" Height="5" CornerRadius="3" Background="#30A46C" HorizontalAlignment="Center"/>
                                <TextBlock Text="黑畫面" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="B" FontSize="9" Foreground="{StaticResource KeyTextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RemoteKey}" Height="56" Tag="12" Margin="4,0" Click="KeyButton_Click" CommandParameter="Meta+d">
                            <StackPanel>
                                <Border Width="26" Height="5" CornerRadius="3" Background="#F5D90A" HorizontalAlignment="Center"/>
                                <TextBlock Text="桌面" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="Win+D" FontSize="9" Foreground="{StaticResource KeyTextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RemoteKey}" Height="56" Tag="12" Margin="4,0,0,0" Click="KeyButton_Click" CommandParameter="Alt+F4">
                            <StackPanel>
                                <Border Width="26" Height="5" CornerRadius="3" Background="#3E63DD" HorizontalAlignment="Center"/>
                                <TextBlock Text="關閉" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="Alt+F4" FontSize="9" Foreground="{StaticResource KeyTextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <UniformGrid Columns="3" Margin="0,10,0,0">
                        <Button Style="{StaticResource RemoteKey}" Height="40" Tag="20" Margin="0,0,4,0" Click="KeyButton_Click" CommandParameter="Control+c">
                            <TextBlock Text="複製"/>
                        </Button>
                        <Button Style="{StaticResource RemoteKey}" Height="40" Tag="20" Margin="4,0" Click="KeyButton_Click" CommandParameter="Control+v">
                            <TextBlock Text="貼上"/>
                        </Button>
                        <Button Style="{StaticResource RemoteKey}" Height="40" Tag="20" Margin="4,0,0,0" Click="KeyButton_Click" CommandParameter="Control+z">
                            <TextBlock Text="復原"/>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- 機身下緣的品牌壓印 -->
                <TextBlock Text="C O N N E C T I T" Foreground="#40FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,30,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="HintText" Foreground="{StaticResource KeyTextMuted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"/>
    </StackPanel>
    </ScrollViewer>
</Window>
