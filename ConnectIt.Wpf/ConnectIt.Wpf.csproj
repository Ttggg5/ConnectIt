<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- CI 用 -p:Version=1.0.{建置編號} 覆寫,自我更新(UpdateService)拿這個跟 GitHub Release 的版本比大小。 -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同時啟用 WPF 與 WinForms(系統匣圖示用)時,ImplicitUsings 會把兩邊同名的型別
         (KeyEventArgs、DragEventArgs、Color 等)變成模稜兩可的參考,所以移除 WinForms 那組
         全域 using,改成只在需要的檔案(App.xaml.cs)裡明確 using。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <!-- 螢幕鏡像的聲音:分享端用 WASAPI loopback 擷取系統聲音,觀看端用 WASAPI 低延遲播放。 -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <!-- 螢幕鏡像分享端用 DXGI Desktop Duplication 擷取畫面(比 GDI BitBlt 快好幾倍,見 DesktopDuplicationSource.cs)。 -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

</Project>
